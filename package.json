{
  "name": "screen-split",
  "productName": "Screen Split",
  "version": "1.0.0",
  "description": "Birden fazla web sayfası, doküman ve notu tek ekranda eşit bölünmüş kutularda göster.",
  "main": "src/main.js",
  "author": "Kayhan TEKİN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kayhantekin.screensplit",
    "productName": "Screen Split",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Screen-Split-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Screen-Split-Tasinabilir-${version}.${ext}"
    },
    "appx": {
      "applicationId": "ScreenSplit",
      "displayName": "Screen Split",
      "identityName": "KayhanTEKN.ScreenSplit",
      "publisher": "CN=A94C9337-5C18-44C3-9DCE-433C130AD6A2",
      "publisherDisplayName": "Kayhan TEKİN",
      "languages": [
        "tr-TR"
      ],
      "artifactName": "Screen-Split-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "xlsx": "^0.18.5"
  }
}